        """
        samsampleX stats \
            --a {input.reference} \
            --b {input.tool_bam} \
            --region {params.region} \
            2> {output.stats}
        """

# Uniform benchmarks only (requested via stats_summary inputs). BAM A = competitor, B = samsampleX-uniform.
rule compare_stats_uniform_pairwise:
