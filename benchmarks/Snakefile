        def parse_stats_file(filepath):
            data = {}
            with open(filepath) as f:
                for line in f:
                    line = line.strip()
                    if "Mean Absolute Error:" in line:
                        match = re.search(r"([\d.]+)\s*$", line)
                        if match:
                            data["mae"] = float(match.group(1))
                    elif "Wasserstein" in line:
                        match = re.search(r"([\d.]+)\s*$", line)
                        if match:
                            data["wasserstein"] = float(match.group(1))
            return data

