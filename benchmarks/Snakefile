        def mean_depth_one_bam(bam_path):
            p = subprocess.Popen(
                ["samtools", "depth", "-r", region, bam_path],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
            )
            total = 0
            n = 0
            for line in p.stdout:
                parts = line.rstrip().split("\t")
                if len(parts) >= 3:
                    total += int(parts[2])
                    n += 1
            err = p.stderr.read()
            rc = p.wait()
            if rc != 0:
                raise RuntimeError(f"samtools depth failed for {bam_path}: {err!r}")
            if n == 0:
                return None
            return total / n

        rows_out = []
        for tool in tools:
            per_seed = []
            for rep in reps:
                bam = f"{benchmark}/{tool}.rep{rep}.bam"
                m = mean_depth_one_bam(bam)
                if m is not None:
                    per_seed.append(m)
            if per_seed:
                dm = statistics.mean(per_seed)
                ds = statistics.stdev(per_seed) if len(per_seed) > 1 else 0.0
            else:
                dm, ds = float("nan"), float("nan")
            rows_out.append((tool, dm, ds))

        with open(output.summary, "w") as out:
            out.write("tool\tdepth_mean\tdepth_std\n")
            for tool, dm, ds in rows_out:
                if math.isnan(dm):
                    out.write(f"{tool}\tNA\tNA\n")
                else:
                    out.write(
                        f"{tool}\t{format_float_sigfigs(dm, sf)}\t{format_float_sigfigs(ds, sf)}\n"
                    )


rule consolidated_summary:
    input:
        runtime="{benchmark}/results_summary.tsv",
        accuracy="{benchmark}/stats_summary.tsv",
        depth="{benchmark}/samtools_depth_summary.tsv",
        coefficient="{benchmark}/coefficient.txt",
    output:
        consolidated="benchmark-{benchmark}.tsv"
    params:
        sigfigs=BENCHMARK_OUTPUT_SIGFIGS,
    run:
        sf = int(params.sigfigs)
        runtime_data = {}
        with open(input.runtime) as f:
            header = f.readline().strip().split('\t')
            col_idx = {h: i for i, h in enumerate(header)}
            for line in f:
                if not line.strip():
                    continue
                fields = line.strip().split('\t')
                tool = fields[0]
                if "samsampleX-map" in tool:
                    continue
                
                wall_mean = fields[col_idx.get('s_mean', -1)]
                wall_std = fields[col_idx.get('s_std', -1)]
                mem_mean = fields[col_idx.get('max_rss_mean', -1)]
                mem_std = fields[col_idx.get('max_rss_std', -1)]
                
                try:
                    mem_mean_gb = float(mem_mean) / 1000
                    mem_std_gb = float(mem_std) / 1000 if mem_std != "NA" else 0
                except (ValueError, TypeError):
                    mem_mean_gb = 0
                    mem_std_gb = 0
                
                runtime_data[tool] = {
                    'wall_mean': wall_mean,
                    'wall_std': wall_std,
                    'mem_mean_gb': mem_mean_gb,
                    'mem_std_gb': mem_std_gb,
                }
        
        accuracy_data = {}
        with open(input.accuracy) as f:
            header = f.readline().strip().split('\t')
            col_idx = {h: i for i, h in enumerate(header)}
            for line in f:
                if not line.strip():
                    continue
                fields = line.strip().split('\t')
                tool = fields[0]
                
                accuracy_data[tool] = {
                    "mae_mean": fields[col_idx.get("mae_mean", -1)],
                    "mae_std": fields[col_idx.get("mae_std", -1)],
                    "signed_depth_mean": fields[
                        col_idx.get("signed_depth_mean", -1)
                    ],
                    "signed_depth_std": fields[
                        col_idx.get("signed_depth_std", -1)
                    ],
                    "w1_mean": fields[col_idx.get("wasserstein_mean", -1)],
                    "w1_std": fields[col_idx.get("wasserstein_std", -1)],
                }

        depth_data = {}
        with open(input.depth) as f:
            f.readline()
            for line in f:
                if not line.strip():
                    continue
                fields = line.strip().split('\t')
                if len(fields) >= 3:
                    depth_data[fields[0]] = {'mean': fields[1], 'std': fields[2]}

        with open(input.coefficient) as _cf:
            coeff_val = float(_cf.read().strip())
        coeff_str = format_float_sigfigs(coeff_val, sf)

        def depth_cell(label):
            key = label[len("samsampleX-vs-"):] if label.startswith("samsampleX-vs-") else label
            d = depth_data.get(key)
            if not d or d.get("mean") in ("NA", ""):
                return "NA"
            try:
                return (
                    f"{format_float_sigfigs(float(d['mean']), sf)} "
                    f"({format_float_sigfigs(float(d['std']), sf)})"
                )
            except (ValueError, TypeError):
                return "NA"

        def format_consolidated_row(tool, rt, acc):
            try:
                wm, ws = float(rt["wall_mean"]), float(rt["wall_std"])
                wall_str = f"{format_float_sigfigs(wm, sf)} ({format_float_sigfigs(ws, sf)})"
            except (ValueError, TypeError):
                wall_str = f"{rt['wall_mean']} ({rt['wall_std']})"
            mem_str = (
                f"{format_float_sigfigs(rt['mem_mean_gb'], sf)} "
                f"({format_float_sigfigs(rt['mem_std_gb'], sf)})"
            )
            d_str = depth_cell(tool)
            try:
                mm, ms = acc.get("mae_mean"), acc.get("mae_std")
                if mm in (None, "", "NA") or ms in (None, "", "NA"):
                    mae_str = "NA"
                else:
                    mae_str = (
                        f"{format_float_sigfigs(float(mm), sf)} "
                        f"({format_float_sigfigs(float(ms), sf)})"
                    )
            except (ValueError, TypeError):
                mae_str = "NA"
            try:
                sm, ss = acc.get("signed_depth_mean"), acc.get("signed_depth_std")
                if sm in (None, "", "NA") or ss in (None, "", "NA"):
                    signed_str = "NA"
                else:
                    signed_str = (
                        f"{format_float_sigfigs(float(sm), sf)} "
                        f"({format_float_sigfigs(float(ss), sf)})"
                    )
            except (ValueError, TypeError):
                signed_str = "NA"
            try:
                wm1, ws1 = acc.get("w1_mean"), acc.get("w1_std")
                if wm1 in (None, "", "NA") or ws1 in (None, "", "NA"):
                    w1_str = "NA"
                else:
                    w1_str = (
                        f"{format_float_sigfigs(float(wm1), sf)} "
                        f"({format_float_sigfigs(float(ws1), sf)})"
                    )
            except (ValueError, TypeError):
                w1_str = "NA"
            return (
                f"{tool}\t{wall_str}\t{mem_str}\t{coeff_str}\t{d_str}\t"
                f"{mae_str}\t{signed_str}\t{w1_str}\n"
            )

        with open(output.consolidated, 'w') as out:
            out.write(
                "Tool\tWall Clock (s)\tMemory (GB)\tCoefficient\tDepth (samtools)\t"
                "MAE\tMean signed depth diff\tW1\n"
            )
            if uses_uniform_samsample(wildcards.benchmark):
                competitors = get_non_samsamplex_comparison_tools(wildcards.benchmark)
                samx_rt = runtime_data.get(
                    "samsampleX-uniform",
                    {
                        "wall_mean": "NA",
                        "wall_std": "NA",
                        "mem_mean_gb": 0.0,
                        "mem_std_gb": 0.0,
                    },
                )
                sorted_comp = sorted(
                    [t for t in competitors if t in runtime_data],
                    key=lambda t: float(runtime_data[t]["wall_mean"])
                    if runtime_data[t]["wall_mean"] not in ["NA", ""]
                    else 999,
                )
                for tool in sorted_comp:
                    out.write(format_consolidated_row(tool, runtime_data[tool], {}))
                # Standalone samsampleX row: own wall/mem, coefficient, samtools depth on
                # samsampleX-uniform BAMs (vs-* rows above use ref-tool depth only).
                if "samsampleX-uniform" in runtime_data:
                    out.write(
                        format_consolidated_row(
                            "samsampleX-uniform",
                            runtime_data["samsampleX-uniform"],
                            {},
                        )
                    )
                for ref_tool in competitors:
                    label = f"samsampleX-vs-{ref_tool}"
                    out.write(
                        format_consolidated_row(
                            label, samx_rt, accuracy_data.get(label, {})
                        )
                    )
            else:
                sorted_tools = sorted(
                    runtime_data.keys(),
                    key=lambda t: float(runtime_data[t]["wall_mean"])
                    if runtime_data[t]["wall_mean"] not in ["NA", ""]
                    else 999,
                )
                for tool in sorted_tools:
                    out.write(
                        format_consolidated_row(
                            tool,
                            runtime_data[tool],
                            accuracy_data.get(tool, {}),
                        )
                    )


