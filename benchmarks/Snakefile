checkpoint master_seed_manifest:
    """Shared seeds for all benchmarks (see master_seeds.json). Invalidates when config.yaml changes."""
    input:
        cfg="config.yaml",
    output:
        json=MASTER_SEEDS_JSON,
    run:
        import secrets

        upper = 2**31 - 1

        def draw_seed():
            return secrets.randbelow(upper) + 1

        R = max(get_config(b, "n_replicates") for b in BENCHMARKS)
        payload = {
            "map_seed": draw_seed(),
            "replicate_seeds": [draw_seed() for _ in range(R)],
        }
        with open(output.json, "w") as f:
            json.dump(payload, f, indent=2)


def _load_master_seeds():
    ck = checkpoints.master_seed_manifest.get()
    with open(ck.output.json) as f:
        return json.load(f)


def seeds_for_benchmark(wildcards):
    data = _load_master_seeds()
    n = get_config(wildcards.benchmark, "n_replicates")
    rs = data["replicate_seeds"]
    if n > len(rs):
        raise ValueError(
            f"master_seeds.json has {len(rs)} replicate seeds but "
            f"{wildcards.benchmark!r} requires n_replicates={n}; rerun workflow or regenerate master_seeds.json"
        )
    return rs[:n]


def get_seeds(wildcards):
    return seeds_for_benchmark(wildcards)


def get_map_seed(wildcards):
    return _load_master_seeds()["map_seed"]


def get_plot_seed(wildcards):
    return seeds_for_benchmark(wildcards)[0]


