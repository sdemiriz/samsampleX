import os
import re
from textwrap import dedent

BENCHMARKS = list(config["benchmarks"].keys())

# Significant figures for aggregated benchmark TSV numeric columns (see params.sigfigs on summary rules).
BENCHMARK_OUTPUT_SIGFIGS = 3

# Single preset for the whole benchmark workflow: every subsample RNG is derived from this value so runs are
# reproducible without a seed manifest. Change this to invalidate/compare separate experiments.
WORKFLOW_ROOT_SEED = 42
_U31_MAX = 2**31 - 1


def derive_u31(root: int, benchmark: str, tool: str, rep: int) -> int:
    """Deterministic 31-bit subsample seed for (benchmark, tool, replicate index)."""
    msg = f"{root}:{benchmark}:{tool}:{rep}".encode()
    digest = hashlib.sha256(msg).digest()
    return 1 + int.from_bytes(digest[:4], "big") % _U31_MAX


def derive_map_seed(root: int, benchmark: str) -> int:
    """RNG seed for samsampleX map (one value per benchmark)."""
    msg = f"{root}:{benchmark}:samsampleX-map:0".encode()
    digest = hashlib.sha256(msg).digest()
    return 1 + int.from_bytes(digest[:4], "big") % _U31_MAX


def replicate_indices(benchmark: str) -> list[int]:
    """Replicate indices 1 .. n_replicates (paths use ``rep`` wildcards; RNG per tool is derive_u31(...))."""
    n = get_config(benchmark, "n_replicates")
    return list(range(1, n + 1))


def plot_replicate_index() -> int:
    """Which replicate index to pass to plot.py for selecting tool BAMs (first replicate)."""
    return 1

# Subset of tool names used as {tool} wildcard in index_output_bam / compare_stats.
TOOL_PATTERN = (
    "gatk-high-accuracy|gatk-constant-memory|gatk-chained|"
    "samtools|sambamba|samsampleX-sample|samsampleX-uniform"
)

# Non-samsampleX tools: pairwise stats vs samsampleX-uniform on uniform benchmarks only.
REF_TOOL_PATTERN = "gatk-high-accuracy|gatk-constant-memory|gatk-chained|samtools|sambamba"


def uses_uniform_samsample(benchmark):
    """Benchmarks with no template BAMs use samsampleX --uniform instead of map+sample."""
    return "templates" not in config["benchmarks"][benchmark]


def get_comparison_tools(benchmark):
    tools = [
        "gatk-high-accuracy",
        "gatk-constant-memory",
        "gatk-chained",
        "samtools",
        "sambamba",
    ]
    tools.append(
        "samsampleX-uniform" if uses_uniform_samsample(benchmark) else "samsampleX-sample"
    )
    return tools


def get_non_samsamplex_comparison_tools(_benchmark):
    """GATK / samtools / sambamba names used for uniform pairwise stats (_benchmark reserved for future per-benchmark lists)."""
    return [
        "gatk-high-accuracy",
        "gatk-constant-memory",
        "gatk-chained",
        "samtools",
        "sambamba",
    ]


def get_plot_tools(benchmark):
    tools = [
        "gatk-constant-memory",
        "samtools",
        "sambamba",
    ]
    tools.append(
        "samsampleX-uniform" if uses_uniform_samsample(benchmark) else "samsampleX-sample"
    )
    return tools


def get_stats_reference(benchmark):
    """Reference input for samsampleX stats: source BAM for uniform; combined template BED otherwise."""
    if uses_uniform_samsample(benchmark):
        return f"{benchmark}/source.bam"
    return f"{benchmark}/samsampleX-template.bed"


def get_config(benchmark, key):
    return config["benchmarks"][benchmark][key]


def get_map_mode(benchmark):
    return get_config(benchmark, "map_mode")


def get_sample_mode(benchmark):
    return get_config(benchmark, "sample_mode")


def get_region(benchmark):
    cfg = config["benchmarks"][benchmark]
    return f"{cfg['chr']}:{cfg['start']}-{cfg['end']}"

def get_templates(benchmark):
    return config["benchmarks"][benchmark]["templates"]


def format_float_sigfigs(x, sigfigs: int) -> str:
    """Format numeric values for summary TSVs using *sigfigs* significant digits (.ng)."""
    if isinstance(x, bool):
        return str(x)
    if isinstance(x, (int, float)):
        xf = float(x)
        if xf != xf:  # NaN
            return "NA"
        n = int(sigfigs)
        if n <= 0:
            return repr(xf)
        return format(xf, f".{n}g")
    return str(x)


