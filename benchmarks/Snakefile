configfile: "config.yaml"

import re

rep = range(1, config["parameters"]["n_replicates"] + 1)

cpus_per_task = config["parameters"]["cpus_per_task"]
mem_mb = config["parameters"]["mem_mb"]
runtime = config["parameters"]["runtime"]

coding_sequence_annotations = "exons_38.bed"


def parse_region(region_str):
    """Parse samtools-style region; return (contig, 0-based start, 0-based exclusive end)."""
    m = re.match(r"^([^:]+)(?::(\d+)(?:-(\d+))?)?$", region_str)
    if not m:
        raise ValueError(f"Invalid region format: {region_str}")
    contig = m.group(1)
    start = int(m.group(2)) - 1 if m.group(2) else -1
    end = int(m.group(3)) if m.group(3) else -1
    return contig, start, end


def load_coding_sequences_in_region(bed_path, contig, region_start, region_end):
    """Return BED3 intervals fully contained in [region_start, region_end)."""
    if region_start < 0 or region_end < 0:
        return []

    intervals = []
    with open(bed_path) as fp:
        for line in fp:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            parts = line.split("\t")
            if len(parts) < 3 or parts[0] != contig:
                continue
            es0 = int(parts[1])
            ee0 = int(parts[2])
            if es0 >= region_end:
                break
            if es0 >= region_start and ee0 <= region_end:
                intervals.append((es0, ee0))

    intervals.sort(key=lambda t: (t[0], t[1]))
    return intervals


def add_coding_sequence_track(ax, region_str, bed_path):
    """Draw coding-sequence rectangles on a horizontal line below the depth curves."""
    from matplotlib.patches import Rectangle

    contig, rs, re_0 = parse_region(region_str)
    if rs < 0 or re_0 <= rs:
        return

    sequences = load_coding_sequences_in_region(bed_path, contig, rs, re_0)
    if not sequences:
        return

    ax.spines["bottom"].set_zorder(2)
    ax.set_xlim(rs + 1, re_0)

    ymin_data, ymax = ax.get_ylim()
    pad = max((ymax - ymin_data) * 0.08, 1e-12)
    ax.set_ylim(ymin_data - pad, ymax)

    y_mid = ymin_data - pad / 2
    chunk_h = min(pad * 0.42, pad * 0.95)
    y_rect_bottom = y_mid - chunk_h / 2

    x_lo, x_hi = ax.get_xlim()
    ax.plot(
        [x_lo, x_hi],
        [y_mid, y_mid],
        color="black",
        linewidth=0.8,
        solid_capstyle="round",
        zorder=3,
    )

    for es0, ee0 in sequences:
        patch = Rectangle(
            (es0 + 1, y_rect_bottom),
            ee0 - es0,
            chunk_h,
            facecolor="black",
            edgecolor="black",
            linewidth=0.2,
            zorder=3,
        )
        ax.add_patch(patch)


