# Coefficient: template benchmarks = mean(samtools view -c per template) / samtools view -c source
# (same region as get_region). Uniform benchmarks still set coefficient in config.yaml.
rule coefficient_from_templates:
    input:
        lambda wildcards: template_coefficient_input_paths(wildcards),
    output:
        coefficient="{benchmark}/coefficient.txt",
    params:
        template_bams=lambda wc: " ".join(get_templates(wc.benchmark)),
        source=lambda wc: get_config(wc.benchmark, "source"),
        region=lambda wc: get_region(wc.benchmark),
    wildcard_constraints:
        benchmark=TEMPLATE_BENCHMARK_REGEX,
    resources:
        cpus=lambda wc: get_config(wc.benchmark, "cpu"),
        mem_mb=lambda wc: get_config(wc.benchmark, "mem_mb"),
        time=lambda wc: get_config(wc.benchmark, "time"),
    container:
        "bench.sif"
    shell:
        dedent(
            """
            set -euo pipefail
            region='{params.region}'
            sum=0
            n=0
            for b in {params.template_bams}; do
                c=$(samtools view -c "$b" "$region")
                sum=$((sum + c))
                n=$((n + 1))
            done
            if [ "$n" -eq 0 ]; then
                echo "coefficient_from_templates: no template BAMs" >&2
                exit 1
            fi
            src=$(samtools view -c "{params.source}" "$region")
            if [ "$src" -eq 0 ]; then
                echo "coefficient_from_templates: source read count is 0" >&2
                exit 1
            fi
            awk -v s="$sum" -v n="$n" -v src="$src" 'BEGIN {{ printf "%.17g\\n", (s / n) / src }}' > {output.coefficient}
            """
        ).strip()
        + "\n"


