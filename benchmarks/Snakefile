UNIFORM_BENCHMARKS = [b for b in BENCHMARKS if uses_uniform_samsample(b)]
TEMPLATE_BENCHMARKS = [b for b in BENCHMARKS if not uses_uniform_samsample(b)]


def _benchmark_regex(names):
    """Regex matching exactly one of *names* (for disjoint wildcard_constraints)."""
    if not names:
        return "__no_matching_benchmark__"
    return "(" + "|".join(re.escape(n) for n in names) + ")"


TEMPLATE_BENCHMARK_REGEX = _benchmark_regex(TEMPLATE_BENCHMARKS)
UNIFORM_BENCHMARK_REGEX = _benchmark_regex(UNIFORM_BENCHMARKS)


def template_coefficient_input_paths(wildcards):
    """Each template .bam and .bai, then config source .bam and .bai (for samtools -c on region)."""
    b = wildcards.benchmark
    paths = []
    for t in get_templates(b):
        paths.append(t)
        paths.append(t + ".bai")
    s = get_config(b, "source")
    paths.extend([s, s + ".bai"])
    return paths


