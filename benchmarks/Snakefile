rule index_bam:
    input:
        bam="{filename}",
    output:
        index="{filename}.bai",
    container:
        "bench.sif",
    shell:
        """
        samtools index {input.bam}
        """

rule get_coefficient_templated:
    input:
        templates=lambda wc: config["benchmarks"][wc.benchmark]["templates"],
        source=lambda wc: config["parameters"]["source"],
    params:
        region=lambda wc: config["benchmarks"][wc.benchmark]["region"],
    wildcard_constraints:
        benchmark="^templated.*",
    output:
        coefficient="{benchmark}/coefficient.txt",
    run:
        import pysam
        import numpy as np

        def read_count(bam, region):
            chrom, rest = region.split(":", 1)
            with pysam.AlignmentFile(bam) as bf:
                names = set(bf.references)
            candidates = [chrom, chrom.removeprefix("chr"), f"chr{chrom}"]
            for name in candidates:
                if name in names:
                    return int(pysam.samtools.view("-c", bam, f"{name}:{rest}").strip())
            raise ValueError(f"No matching contig for {region} in {bam}; have {sorted(names)[:5]}...")

        mean_template = float(np.mean([read_count(t, params.region) for t in input.templates]))
        source_count = read_count(input.source, params.region)
        ratio = mean_template / source_count
        with open(output.coefficient, "w") as f:
            f.write(f"{ratio}\n")

rule get_coefficient_uniform:
    input:
        source=lambda wc: config["parameters"]["source"],
    params:
        region=lambda wc: config["benchmarks"][wc.benchmark]["region"],
        target_depth=lambda wc: config["benchmarks"][wc.benchmark]["target_depth"],
    wildcard_constraints:
        benchmark="^uniform.*",
    output:
        coefficient="{benchmark}/coefficient.txt",
    run:
        import io
        import pysam
        import pandas as pd

        # Get number of reads in source and average coverage in the region
        # Calculate how many reads need to be retained to get target coverage

        depths = pysam.samtools.depth(input.source, "-r", params.region, "-H", "-q", "0", "-Q", "0")
        source_average_depth = float(
            pd.read_csv(io.StringIO(depths), sep="\t", usecols=[2]).iloc[:, 0].mean()
        )
        ratio = params.target_depth / source_average_depth
        with open(output.coefficient, "w") as f:
            f.write(f"{ratio}\n")

