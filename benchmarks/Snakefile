rule plot_templates:
    input:
        template_depths="{benchmark}/template-depths.tsv",
        coding_bed=coding_sequence_annotations,
    params:
        region=lambda wc: config["benchmarks"][wc.benchmark]["region"],
        templates=lambda wc: config["benchmarks"][wc.benchmark]["templates"],
    output:
        plot="{benchmark}/templates-plot.png",
    container:
        "bench.sif",
    resources:
        cpus_per_task=cpus_per_task,
        mem_mb=mem_mb,
        runtime=runtime,
    run:
        import pandas as pd
        import matplotlib.pyplot as plt
        import matplotlib.ticker as mtick

        template_depths = pd.read_csv(input.template_depths, sep="\t")
        positions = template_depths["POS"]
        template_depths.drop(columns=["#CHROM", "POS"], inplace=True)

        means = template_depths.mean(axis=1)
        stds = template_depths.std(axis=1)

        fig, ax = plt.subplots(figsize=(10, 6))

        # Shaded ±1 std band
        ax.fill_between(positions, means - stds, means + stds, color="lightgray", alpha=0.6, label="±1 SD")

        # Mean depth line
        ax.plot(positions, means, color="#8da0cb", linewidth=1.5, label="Mean depth")

        # Horizontal grid only, sent behind the data
        ax.yaxis.grid(True, linestyle="--", linewidth=0.6, color="gray", alpha=0.5)
        ax.xaxis.grid(False)
        ax.xaxis.get_major_formatter().set_useOffset(False)
        ax.xaxis.set_major_formatter(mtick.StrMethodFormatter('{x:,.0f}'))
        ax.tick_params(axis='y', length=0)
        ax.set_axisbelow(True)

        # Remove top, left, and right spines
        for spine in ("top", "left", "right"):
            ax.spines[spine].set_visible(False)

        ax.set_title("1000 Genomes WGS 30x depth variation across region")
        ax.set_xlabel(r'Position along $\it{HLA\text{-}A}$ gene region (bp)')
        ax.set_ylabel("Depth")
        ax.legend(frameon=False)

        add_coding_sequence_track(ax, params.region, input.coding_bed)

        fig.savefig(output.plot, dpi=300, bbox_inches="tight")

rule get_downsampling_results:
    input:
        source_bam="{benchmark}/source.bam",
        source_index="{benchmark}/source.bam.bai",
        bams=expand("{{benchmark}}/downsampled-bams/{tool}-rep{rep}.bam", tool=config["parameters"]["tools"], rep=rep),
        index=expand("{{benchmark}}/downsampled-bams/{tool}-rep{rep}.bam.bai", tool=config["parameters"]["tools"], rep=rep),
    params:
        benchmark=lambda wc: wc.benchmark,
        region=lambda wc: config["benchmarks"][wc.benchmark]["region"],
    output:
        list="{benchmark}/downsampling-results.list",
        depths="{benchmark}/downsampling-results.tsv",
    container:
        "bench.sif",
    resources:
        cpus_per_task=cpus_per_task,
        mem_mb=mem_mb,
        runtime=runtime,
    shell:
        r"""
        echo "{input.bams}" | tr ' ' '\n' > {output.list} &&
        echo "{input.source_bam}" >> {output.list} &&
        samtools depth -f {output.list} -r {params.region} -H -q 0 -Q 0 > {output.depths}
        """

rule plot_downsampled_templated:
    input:
        downsampling_results="{benchmark}/downsampling-results.tsv",
        template="{benchmark}/template.bed",
        coding_bed=coding_sequence_annotations,
    params:
        benchmark=lambda wc: wc.benchmark,
        region=lambda wc: config["benchmarks"][wc.benchmark]["region"],
        tools=config["parameters"]["tools"],
    wildcard_constraints:
        benchmark="^templated.*",
    output:
        plot="{benchmark}/downsampling-results-plot.png",
    container:
        "bench.sif",
    resources:
        cpus_per_task=cpus_per_task,
        mem_mb=32768,
        runtime=runtime,
    run:
        import pandas as pd
        import matplotlib.pyplot as plt
        import matplotlib.ticker as mtick

        downsampling_cols = pd.read_csv(input.downsampling_results, sep="\t", nrows=0).columns
        positions = pd.read_csv(input.downsampling_results, sep="\t", usecols=[1])

        styles = {
            "source":               {"color": "#66c2a5", "linestyle": "-"},
            "template":             {"color": "#fc8d62", "linestyle": "-"},
            "gatk-constant-memory": {"color": "#bdbdbd", "linestyle": "--"},
            "gatk-high-accuracy":   {"color": "#969696", "linestyle": "--"},
            "gatk-chained":         {"color": "#737373", "linestyle": "--"},
            "samtools":             {"color": "#636363", "linestyle": "--"},
            "sambamba":             {"color": "#252525", "linestyle": "--"},
            "samsampleX":           {"color": "#8da0cb", "linestyle": "-"},
        }

        fig, ax = plt.subplots(figsize=(10, 6))

        source_depths = pd.read_csv(input.downsampling_results, sep="\t", usecols=[t for t in downsampling_cols if "source" in t])
        ax.plot(positions, source_depths, label="source", linestyle=styles["source"]["linestyle"], color=styles["source"]["color"])

        template_depths = pd.read_csv(input.template, sep="\t", usecols=[3], header=None)
        ax.plot(positions, template_depths, label="template", linestyle=styles["template"]["linestyle"], color=styles["template"]["color"])

        for tool in params.tools:
            downsampling_depths = pd.read_csv(input.downsampling_results, sep="\t", usecols=[t for t in downsampling_cols if tool in t])
            ax.plot(positions, downsampling_depths.mean(axis=1), label=tool, linestyle=styles[tool]["linestyle"], color=styles[tool]["color"])
        ax.legend()

        # Horizontal grid only, sent behind the data
        ax.yaxis.grid(True, linestyle="--", linewidth=0.6, color="gray", alpha=0.5)
        ax.xaxis.grid(False)
        ax.set_axisbelow(True)

        # Remove top, left, and right spines
        for spine in ("top", "left", "right"):
            ax.spines[spine].set_visible(False)

        ax.set_title("Pattern-aware downsampling in Whole Exome Genome Sequencing")
        ax.set_xlabel(r'Position along $\it{TP53}$ gene region (bp)')
        ax.set_ylabel("Depth")
        ax.xaxis.set_major_formatter(mtick.StrMethodFormatter('{x:,.0f}'))
        ax.tick_params(axis='y', length=0)
        ax.legend(loc="upper right", frameon=False)

        add_coding_sequence_track(ax, params.region, input.coding_bed)

        fig.savefig(output.plot, dpi=300)

rule plot_downsampled_uniform:
    input:
        downsampling_results="{benchmark}/downsampling-results.tsv",
        coding_bed=coding_sequence_annotations,
    params:
        benchmark=lambda wc: wc.benchmark,
        region=lambda wc: config["benchmarks"][wc.benchmark]["region"],
        target_depth=lambda wc: config["benchmarks"][wc.benchmark]["target_depth"],
        tools=config["parameters"]["tools"],
    wildcard_constraints:
        benchmark="^uniform.*",
    output:
        plot="{benchmark}/downsampling-results-plot.png",
    container:
        "bench.sif",
    resources:
        cpus_per_task=cpus_per_task,
        mem_mb=32768,
        runtime=runtime,
    run:
        import pandas as pd
        import matplotlib.pyplot as plt

        downsampling_cols = pd.read_csv(input.downsampling_results, sep="\t", nrows=0).columns
        positions = pd.read_csv(input.downsampling_results, sep="\t", usecols=[1])

        styles = {
            "source":               {"color": "#66c2a5", "linestyle": "-"},
            "template":             {"color": "#fc8d62", "linestyle": "-"},
            "gatk-constant-memory": {"color": "#bdbdbd", "linestyle": "--"},
            "gatk-high-accuracy":   {"color": "#969696", "linestyle": "--"},
            "gatk-chained":         {"color": "#737373", "linestyle": "--"},
            "samtools":             {"color": "#636363", "linestyle": "--"},
            "sambamba":             {"color": "#252525", "linestyle": "--"},
            "samsampleX":           {"color": "#8da0cb", "linestyle": "-"},
        }

        fig, ax = plt.subplots(figsize=(10, 6))
        
        source_depths = pd.read_csv(input.downsampling_results, sep="\t", usecols=[t for t in downsampling_cols if "source" in t])
        ax.plot(positions, source_depths, label="source", linestyle=styles["source"]["linestyle"], color=styles["source"]["color"])

        for tool in params.tools:
            downsampling_depths = pd.read_csv(input.downsampling_results, sep="\t", usecols=[t for t in downsampling_cols if tool in t])
            ax.plot(positions, downsampling_depths.mean(axis=1), label=tool, linestyle=styles[tool]["linestyle"], color=styles[tool]["color"])

        ax.axhline(y=params.target_depth, color="red", linestyle="--", label="target depth")

        # Horizontal grid only, sent behind the data
        ax.yaxis.grid(True, linestyle="--", linewidth=0.6, color="gray", alpha=0.5)
        ax.xaxis.grid(False)
        ax.set_axisbelow(True)

        # Remove top, left, and right spines
        for spine in ("top", "left", "right"):
            ax.spines[spine].set_visible(False)

        ax.set_title("Downsampling results")
        ax.set_xlabel("Position")
        ax.set_ylabel("Depth")
        ax.xaxis.get_major_formatter().set_useOffset(False)
        ax.legend(loc="upper right", frameon=False)

        add_coding_sequence_track(ax, params.region, input.coding_bed)

        fig.savefig(output.plot, dpi=300)

rule plot_boxplots:
    input:
        downsampling_results="{benchmark}/downsampling-results.tsv",
    params:
        benchmark=lambda wc: wc.benchmark,
        tools=config["parameters"]["tools"],
    output:
        plot="{benchmark}/depths-boxplot.png",
    container:
        "bench.sif",
    resources:
        cpus_per_task=cpus_per_task,
        mem_mb=mem_mb,
        runtime=runtime,
    run:
        import pandas as pd
        import matplotlib.pyplot as plt
        import matplotlib.patches as mpatches
        import numpy as np

        data = {}

        if wildcards.benchmark.startswith("templated"):
            template_depths = pd.read_csv(f"{wildcards.benchmark}/template.bed", sep="\t", usecols=[3], header=None)
            data["template"] = template_depths.iloc[:, 0].tolist()

        downsampling_cols = pd.read_csv(input.downsampling_results, sep="\t", nrows=0).columns
        for tool in params.tools:
            tool_cols = [c for c in downsampling_cols if tool in c]
            tool_depths = pd.read_csv(input.downsampling_results, sep="\t", usecols=tool_cols)
            tool_depths["mean"] = tool_depths.mean(axis=1)
            data[tool] = list(tool_depths["mean"])

        fig, ax = plt.subplots(figsize=(10, 6))

        ax.boxplot(
            x=list(data.values()),
            tick_labels=list(data.keys()),
            patch_artist=True,
            showfliers=False,
            showmeans=True,
            meanline=True,
            medianprops=dict(color="red", linewidth=2, linestyle="-"),
            meanprops=dict(color="black", linewidth=2, linestyle="-"),
            whiskerprops=dict(linewidth=2),
            capprops=dict(linewidth=0),
            boxprops=dict(facecolor="steelblue", alpha=0.6),
        )

        ax.yaxis.grid(True, color="lightgray", linewidth=1)
        ax.set_axisbelow(True)

        for spine in ("top", "left", "right"):
            ax.spines[spine].set_visible(False)

        handles = [
            mpatches.Patch(color="red", label="Median"),
            mpatches.Patch(color="black", label="Mean"),
        ]

        ax.legend(handles=handles, loc="upper right")
        fig.tight_layout()
        fig.savefig(output.plot, dpi=300)
        