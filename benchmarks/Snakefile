        source_index="{benchmark}/source.bam.bai",
        tool_bams=get_plot_tool_bams,
    output:
        png="{benchmark}/{benchmark}-comparison.png",
        tsv="{benchmark}/{benchmark}-comparison.tsv",
    params:
        root=SAMSAMPLEX_ROOT,
