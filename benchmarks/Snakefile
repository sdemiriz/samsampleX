        echo "{input.bams}" | tr ' ' '\n' > {output.list} &&
        samtools depth \
        -f {output.list} \
        -r {params.region} \
        -H -q 0 -Q 0 > {output.depths}
        """

rule full_summary:
    input:
        resources=expand("{{benchmark}}/resource-benchmarks/{tool}-rep{rep}.tsv", tool=config["parameters"]["tools"], rep=rep),
        depths="{benchmark}/depths.tsv",
        coefficient="{benchmark}/coefficient.txt",
        template_depths="{benchmark}/template-depths.tsv",
    output:
        summary="{benchmark}/summary.tsv",
        accuracy="{benchmark}/accuracy.tsv",
        depths_comparison_matrix="{benchmark}/depths-comparison-matrix.tsv",
    params:
        tools=config["parameters"]["tools"],
        coefficient=lambda wc, input: float(open(input.coefficient).read().strip()),
        target_depth=lambda wc: config["benchmarks"].get(wc.benchmark, {}).get("target_depth", None),
    container:
        "bench.sif",
    resources:
        cpus_per_task=cpus_per_task,
        mem_mb=32768,
        runtime=runtime,
    run:
        import pandas as pd
        import numpy as np
        import itertools

        # Aggregate resource usage statistics
        rows = []
        for tool in params.tools:
            files = [f for f in input.resources if tool in f]
            df = pd.concat([pd.read_csv(f, sep="\t") for f in files], axis=0)[["cpu_time", "max_rss"]]
            df["max_rss"] = df["max_rss"] / 1024
            rows.append({
                "Tool": tool,
                "Mean runtime [s] (SD)": f"{df['cpu_time'].mean():>6.3f} ({df['cpu_time'].std():>6.3f})",
                "Mean memory [GB] (SD)": f"{df['max_rss'].mean():>6.3f} ({df['max_rss'].std():>6.3f})",
            })

        resource_usage = pd.DataFrame(rows)

        # Read column names
        depth_cols = pd.read_csv(input.depths, sep="\t", nrows=0).columns

        # Average means across replicates
        depths = pd.DataFrame()
        rows = []
        for tool in params.tools:
            dp = pd.read_csv(input.depths, sep="\t", usecols=[t for t in depth_cols if tool in t])
            depths[tool + "_mean"] = dp.mean(axis=1)
            depths[tool + "_std"] = dp.std(axis=1)

            row = {
                "Tool": tool,
                "Mean depth (SD)": f"{depths[tool + '_mean'].mean():>6.3f} ({depths[tool + '_std'].mean():>6.3f})",
                "Downsampling coefficient": f"{params.coefficient:>6.3f}" if tool != "samsampleX" else "-",
            }

            if wildcards.benchmark.startswith("templated"):
                # template_bed = pd.read_csv(f"{wildcards.benchmark}/template.bed", sep="\t", header=None, usecols=[3])
                bam_cols = pd.read_csv(f"{wildcards.benchmark}/template-depths.tsv", sep="\t", nrows=0).columns
                template_depths = pd.read_csv(f"{wildcards.benchmark}/template-depths.tsv", sep="\t", usecols=[c for c in bam_cols if ".bam" in c])
                # assert len(template_depths) == len(depths), f"Expected template bed and depths to have the same length {len(template_depths)} != {len(depths)}"
                depths["template_mean"] = template_depths.mean(axis=1)
                depths["template_std"] = template_depths.std(axis=1)
                row["Mean template depth (SD)"] = f"{depths['template_mean'].mean():>6.3f} ({depths['template_std'].mean():>6.3f})" if tool == "samsampleX" else "-"

                depths["abs_depth_diff_mean"] = np.abs(depths["template_mean"].sub(depths[tool + "_mean"], fill_value=0))
                depths["abs_depth_diff_std"] = np.abs(depths["template_std"].sub(depths[tool + "_std"], fill_value=0))
                row["Mean absolute depth difference to template (SD)"] = f"{depths['abs_depth_diff_mean'].mean():>6.3f} ({depths['abs_depth_diff_std'].mean():>6.3f})"

                depths["depth_diff_mean"] = depths["template_mean"].sub(depths[tool + "_mean"], fill_value=0)
                depths["depth_diff_std"] = depths["template_std"].sub(depths[tool + "_std"], fill_value=0)
                row["Mean depth difference to template (SD)"] = f"{depths['depth_diff_mean'].mean():>6.3f} ({depths['depth_diff_std'].mean():>6.3f})"

            elif wildcards.benchmark.startswith("uniform"):
                depths["target_depth"] = params.target_depth
                depths["target_depth_mean"] = depths["target_depth"]
                depths["target_depth_std"] = 0

                row["Target depth"] = f"{depths['target_depth'].mean():>6.3f} ({depths['target_depth'].std():>6.3f})" if tool == "samsampleX" else "-"

                depths["abs_depth_diff_mean"] = np.abs(depths["target_depth_mean"].sub(depths[tool + "_mean"], fill_value=0))
                depths["abs_depth_diff_std"] = np.abs(depths["target_depth_std"].sub(depths[tool + "_std"], fill_value=0))
                row["Mean absolute depth difference to target (SD)"] = f"{depths['abs_depth_diff_mean'].mean():>6.3f} ({depths['abs_depth_diff_std'].mean():>6.3f})"

                depths["depth_diff_mean"] = depths["target_depth_mean"].sub(depths[tool + "_mean"], fill_value=0)
                depths["depth_diff_std"] = depths["target_depth_std"].sub(depths[tool + "_std"], fill_value=0)
                row["Mean depth difference to target (SD)"] = f"{depths['depth_diff_mean'].mean():>6.3f} ({depths['depth_diff_std'].mean():>6.3f})"

            rows.append(row)
        accuracy = pd.DataFrame(rows)
        accuracy.to_csv(output.accuracy, sep="\t", index=False)

        # Make tool comparison matrix
        depths_comparison_matrix = pd.DataFrame(pd.NA,index=params.tools, columns=params.tools)
        
        # Populate diagonal values
        for tool in params.tools:
            diff_mean = np.abs(depths[tool + "_mean"].sub(depths[tool + "_mean"], fill_value=0))
            diff_std = np.abs(depths[tool + "_std"].sub(depths[tool + "_std"], fill_value=0))
            depths_comparison_matrix.loc[tool, tool] = f"{np.abs(diff_mean).mean():>6.3f} ({np.abs(diff_std).mean():>6.3f}) | {diff_mean.mean():>6.3f} ({diff_std.mean():>6.3f})"
        
        # Populate lower triangle (column - rows)
        for tool_a, tool_b in itertools.combinations(params.tools, 2):
            diff_mean = np.abs(depths[tool_b + "_mean"].sub(depths[tool_a + "_mean"], fill_value=0))
            diff_std = np.abs(depths[tool_b + "_std"].sub(depths[tool_a + "_std"], fill_value=0))
            depths_comparison_matrix.loc[tool_b, tool_a] = f"{np.abs(diff_mean).mean():>6.3f} ({np.abs(diff_std).mean():>6.3f}) | {diff_mean.mean():>6.3f} ({diff_std.mean():>6.3f})"

        depths_comparison_matrix.to_csv(output.depths_comparison_matrix, sep="\t", header=True, index=True)

        summary = pd.merge(resource_usage, accuracy, on="Tool", how="inner")
        summary.to_csv(output.summary, sep="\t", index=False)

