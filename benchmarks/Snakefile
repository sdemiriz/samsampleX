rule samsampleX_sampling:
    """Downsample using samsampleX; template depth profile comes from combined map output.

    Config ``sample_mode`` is passed as ``--stat`` (how to summarize template/source ratio
    along each read). ``--mode`` is only for combining multiple template BEDs (not used here).
    """
    input:
        bam="{benchmark}/source.bam",
        index="{benchmark}/source.bam.bai",
        template_bed="{benchmark}/samsampleX-template.bed",
    params:
        sample_mode=lambda wc: get_sample_mode(wc.benchmark),
        region=lambda wc: get_region(wc.benchmark),
        rng_seed=lambda wc: derive_u31(
            WORKFLOW_ROOT_SEED, wc.benchmark, "samsampleX-sample", int(wc.rep)
        ),
    wildcard_constraints:
        rep=r"\d+",
    output:
        bam="{benchmark}/samsampleX-sample.rep{rep}.bam",
    benchmark:
        "{benchmark}/benchmarks/samsampleX-sample.rep{rep}.tsv"
    resources:
        cpus=lambda wc: get_config(wc.benchmark, "cpu"),
        mem_mb=lambda wc: get_config(wc.benchmark, "mem_mb"),
        time=lambda wc: get_config(wc.benchmark, "time"),
    container:
        "bench.sif"
    shell:
        """
        samsampleX sample \
        --source-bam {input.bam} \
        --template-bed {input.template_bed} \
        --out-bam {output.bam} \
        --region {params.region} \
        --seed {params.rng_seed} \
        --stat {params.sample_mode}
        """

rule uniform_plot_template_bed:
    """Target depth curve for plots: source depth × coefficient (no cohort map)."""
    input:
        bam="{benchmark}/source.bam",
        index="{benchmark}/source.bam.bai",
        coefficient="{benchmark}/coefficient.txt",
    output:
        bed="{benchmark}/uniform-plot-template.bed",
    params:
        region=lambda wc: get_region(wc.benchmark),
    resources:
        cpus=lambda wc: get_config(wc.benchmark, "cpu"),
        mem_mb=lambda wc: get_config(wc.benchmark, "mem_mb"),
        time=lambda wc: get_config(wc.benchmark, "time"),
    container:
        "bench.sif"
    shell:
        dedent(
            """
            python3 << 'PY'
            import numpy as np
            from samsamplex.depth import DepthArray, depth_from_bam, region_parse
            from samsamplex.bed import write_bed_output

            bam = "{input.bam}"
            out_path = "{output.bed}"
            region = region_parse("{params.region}")
            with open("{input.coefficient}") as _cf:
                coef = float(_cf.read().strip())
            arr = depth_from_bam(bam, region.contig, region.start, region.end)
            scaled = np.maximum(0, np.round(arr.depths.astype(float) * coef)).astype(np.int32)
            scaled_arr = DepthArray(arr.contig, arr.start, arr.end, scaled)
            with open(out_path, "w") as fp:
                write_bed_output(fp, scaled_arr)
            PY
            """
        ).strip() + "\n"

