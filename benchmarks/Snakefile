>>>>>>> 284611eecdaf5bda7043d645d3d6090cabbd71a5
        # (tool_a, tool_b) -> list of {mae, wasserstein}
        by_pair = {(ta, tb): [] for ta in tools for tb in tools}
        for ta in tools:
            for tb in tools:
                for rep in reps:
                    fp = f"{wildcards.benchmark}/pairstats/{ta}.vs.{tb}.rep{rep}.stats"
                    parsed = parse_stats_file(fp)
                    if parsed:
                        by_pair[(ta, tb)].append(parsed)

        def mean_std(values):
            values = [v for v in values if v is not None]
            if not values:
                return None, None
            m = statistics.mean(values)
            s = statistics.stdev(values) if len(values) > 1 else 0.0
            return m, s

        def format_cell(mae_list, w_list):
            maem, maes = mean_std(mae_list)
            w1m, w1s = mean_std(w_list)
            if maem is None or w1m is None:
                return "NA"
            return (
                f"{format_float_sigfigs(maem, sf)} ({format_float_sigfigs(maes, sf)}) | "
                f"{format_float_sigfigs(w1m, sf)} ({format_float_sigfigs(w1s, sf)})"
            )

        with open(output.matrix, "w") as out:
            header = [""] + tools
            out.write("\t".join(header) + "\n")
            for ta in tools:
                row_cells = [ta]
                for tb in tools:
                    rows = by_pair.get((ta, tb), [])
                    mae_vals = [r.get("mae") for r in rows]
                    w_vals = [r.get("wasserstein") for r in rows]
                    row_cells.append(format_cell(mae_vals, w_vals))
                out.write("\t".join(row_cells) + "\n")


